# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Google Calendar OAuth ──
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── Zoom OAuth ──
ZOOM_CLIENT_ID=xxx
ZOOM_CLIENT_SECRET=xxx
ZOOM_REDIRECT_URI=http://localhost:3000/api/auth/zoom/callback

# ── Razorpay ──
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

# ── WhatsApp (Gupshup) ──
WHATSAPP_API_KEY=xxx
WHATSAPP_API_URL=https://api.gupshup.io/wa/api/v1
WHATSAPP_SOURCE_PHONE=

# ── Email (Resend) ──
RESEND_API_KEY=re_xxx
EMAIL_FROM=hello@mano.app

# ── Rate Limiting (Upstash Redis - optional, uses in-memory for local dev) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Encryption ──
ENCRYPTION_KEY=                          # Required. 32-byte base64-encoded key for AES-256-GCM
ENCRYPTION_KEY_PREVIOUS=                 # Optional. Old key for decryption during key rotation

# ── Sentry (error monitoring) ──
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Cron / Background Jobs ──
CRON_SECRET=                             # Shared secret for cron job endpoints

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
